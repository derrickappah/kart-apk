# SUPABASE_ANON_KEY: Public anon key for Kart's Supabase project.
# Configure this in the AI Studio Secrets panel.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# PAYSTACK_PUBLIC_KEY: Optional Paystack public key if needed client-side.
# PAYSTACK_PUBLIC_KEY=pk_live_or_test_key

# GOOGLE_WEB_CLIENT_ID: OAuth 2.0 Web Client ID from Google Cloud Console
# (also configured in Supabase Auth -> Providers -> Google) for native Credential Manager sign-in.
GOOGLE_WEB_CLIENT_ID=
